      <trans-unit id="fb494cdd286867a332b19dbd0e0f6d68">
        <source>You can redirect your customer with an error message</source>
        <target>Puteți redirecționa clientul dumneavoastră cu un mesaj de eroare</target>
        <note>Line: </note>
      </trans-unit>
      <trans-unit id="a090999d6428c9bafb58cb95cac62b70">
